
###================================  Clocks ========================================###
    ###==== OV5640 Clocks
    create_clock -name {free_clk} [get_ports {free_clk}] -period {40.000} -waveform {0.000 20.000}
    create_generated_clock -name {clk_50m} -source [get_ports {free_clk}] [get_nets {ov5640_clk.clkout0}] -master_clock [get_clocks {free_clk}] -multiply_by {2} -divide_by {1}
    create_generated_clock -name {clk_150m} -source [get_ports {free_clk}] [get_nets {ov5640_clk.clkout1}] -master_clock [get_clocks {free_clk}] -multiply_by {6} -divide_by {1}
    create_generated_clock -name {clk_10m} -source [get_ports {free_clk}] [get_nets {ov5640_clk.clkout2}] -master_clock [get_clocks {free_clk}] -multiply_by {2} -divide_by {5}
    create_generated_clock -name {npu_clk_gated} -source [get_pins {npu_cdc_top.u_bufgce_npu.CLKIN}] [get_pins {npu_cdc_top.u_bufgce_npu.CLKOUT}] -master_clock [get_clocks {clk_150m}] -add

    #create_clock -name {cmos1_pclk} [get_ports {cmos1_pclk}] -period {13.158} -waveform {0.000 6.579}
    #create_clock -name {cmos2_pclk} [get_ports {cmos2_pclk}] -period {11.900} -waveform {0.000 5.950}
    #create_clock -name {pix_clk_in} [get_ports {pixclk_in}] -period {6.670} -waveform {0.000 3.335}
    #create_clock -name {pix_clk_in} [get_ports {pixclk_in}] -period 6.667 -waveform {0.000 3.333}
    create_clock -name {pix_clk_in} [get_ports {pixclk_in}] -period 6.452 -waveform {0.000 3.226}
    #create_clock -name {pix_clk_in} [get_ports {pixclk_in}] -period 6.250 -waveform {0.000 3.125}
  
    #set_clock_uncertainty {0.200} [get_clocks {cmos1_pclk}]  -setup -hold

    #set_clock_uncertainty {0.200} [get_clocks {cmos2_pclk}]  -setup -hold
    ###==== END Clocks

    ###==== DDR3 Clocks
    create_generated_clock -name {rst_clk} -source [get_ports {free_clk}] [get_pins {ddr3.u_ddrphy_top.rst_clk_gpll/clkout0}] -master_clock [get_clocks {free_clk}] -multiply_by {84} -divide_by {84}
    create_generated_clock -name {ddrphy_sysclk} -source [get_ports {free_clk}] [get_pins {ddr3.u_ddrphy_top.ddrphy_gpll/clkout0}] -master_clock [get_clocks {free_clk}] -multiply_by {84} -divide_by {16}
    create_generated_clock -name {phy_dq_clk_0} -source [get_ports {free_clk}] [get_pins {ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {free_clk}] -multiply_by {84} -divide_by {2}
    create_generated_clock -name {phy_dq_sysclk_0} -source [get_pins {ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] [get_pins {ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_0}] -edges {5 13 21} -edge_shift {0 0 0}
    create_generated_clock -name {phy_dq_clk_1} -source [get_ports {free_clk}] [get_pins {ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {free_clk}] -multiply_by {84} -divide_by {2}
    create_generated_clock -name {phy_dq_sysclk_1} -source [get_pins {ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] [get_pins {ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_1}] -edges {5 13 21} -edge_shift {0 0 0}

    set_multicycle_path 2 -setup -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_0]
    set_multicycle_path 1 -hold -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_0]
    set_multicycle_path 2 -setup -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_1]
    set_multicycle_path 1 -hold -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_1]
    set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_0}] -setup -hold
    set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_0}] -to [get_clocks {ddrphy_sysclk}] -setup -hold
    set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_1}] -setup -hold
    set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_1}] -to [get_clocks {ddrphy_sysclk}] -setup -hold
    ###==== END Clocks


    ###==== PCIE Clocks
    create_clock -name {pclk} [get_pins {pcie_fifo.pango_pcie_top.u_ips2l_pcie_wrap.U_IPS2L_PCIE_TOP.U_IPS2L_HSSTLP_PCIE_SOFT_PHY.x2.GTP_HSST_2LANE_TOP.U_GTP_HSSTLP_WRAPPER.CHANNEL1_ENABLE.U_GTP_HSSTLP_LANE1.P_TCLK2FABRIC}] -period {4.000} -waveform {0.000 2.000}
    create_clock -name {pclk_div2} [get_pins {pcie_fifo.pango_pcie_top.u_ips2l_pcie_wrap.U_IPS2L_PCIE_TOP.U_IPS2L_HSSTLP_PCIE_SOFT_PHY.x2.GTP_HSST_2LANE_TOP.U_GTP_HSSTLP_WRAPPER.CHANNEL0_ENABLE.U_GTP_HSSTLP_LANE0.P_TCLK2FABRIC}] -period {8.000} -waveform {0.000 4.000}
    create_clock -name {ref_clk} [get_pins {pcie_fifo.pango_pcie_top.u_ips2l_pcie_wrap.U_IPS2L_PCIE_TOP.U_IPS2L_HSSTLP_PCIE_SOFT_PHY.x2.GTP_HSST_2LANE_TOP.U_GTP_HSSTLP_WRAPPER.PLL0_ENABLE.U_GTP_HSSTLP_PLL0.P_REFCK2CORE}] -period {10.000} -waveform {0.000 5.000}
    ###==== END Clocks



###================================ ASYNCHRONOUS Clocks ========================================###
    ###==== OV5640 Clocks
    set_clock_groups -name clk_50m -asynchronous -group [get_clocks {clk_50m}]
    set_clock_groups -name clk_150m -asynchronous -group [get_clocks {clk_150m}]
    set_clock_groups -name npu_clk_gated -asynchronous -group [get_clocks {npu_clk_gated}]
    set_clock_groups -name clk_10m -asynchronous -group [get_clocks {clk_10m}]

    #set_clock_groups -name cmos1_pclk -asynchronous -group [get_clocks cmos1_pclk]
    #set_clock_groups -name cmos2_pclk -asynchronous -group [get_clocks {cmos2_pclk}]
    set_clock_groups -name pix_clk_in -asynchronous -group [get_clocks {pix_clk_in}]
    ###==== END Clocks


    ###==== DDR3 Clocks
    set_clock_groups -name free_clk -asynchronous -group [get_clocks {free_clk}]
    set_clock_groups -name rst_clk -asynchronous -group [get_clocks {rst_clk}]
    set_clock_groups -name phy_dq_sysclk_0 -asynchronous -group [get_clocks {phy_dq_sysclk_0}]
    set_clock_groups -name phy_dq_sysclk_1 -asynchronous -group [get_clocks {phy_dq_sysclk_1}]
    set_clock_groups -name phy_dq_clk_0 -asynchronous -group [get_clocks {phy_dq_clk_0}]
    set_clock_groups -name phy_dq_clk_1 -asynchronous -group [get_clocks {phy_dq_clk_1}]
    set_clock_groups -name ddrphy_sysclk -asynchronous -group [get_clocks {ddrphy_sysclk}]
    ###==== END Clocks


    ###==== PCIE Clocks 
    set_clock_groups -name pclk -asynchronous -group [get_clocks {pclk}]
    set_clock_groups -name pclk_div2 -asynchronous -group [get_clocks {pclk_div2}]
    set_clock_groups -name ref_clk -asynchronous -group [get_clocks {ref_clk}]
    ###==== END Clocks