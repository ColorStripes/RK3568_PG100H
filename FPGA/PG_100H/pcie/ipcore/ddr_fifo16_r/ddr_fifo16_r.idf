<?xml version="1.0" encoding="UTF-8"?>
<ip_inst>
    <header>
        <vendor>Pango</vendor>
        <id>06100104</id>
        <display_name>Distributed FIFO</display_name>
        <name>Distributed FIFO</name>
        <version>1.4</version>
        <instance>ddr_fifo16_r</instance>
        <family>Logos2</family>
        <device>PG2L100H</device>
        <package>FBG484</package>
        <speedgrade>-6</speedgrade>
        <generator version="2022.2-SP6.4" build="146967">IP Compiler</generator>
    </header>
    <param_list>
        <param>
            <name>RST_TYPE</name>
            <value>SYNC</value>
        </param>
        <param>
            <name>ADDR_WIDTH</name>
            <value>4</value>
        </param>
        <param>
            <name>FIFO_TYPE</name>
            <value>SYNC_FIFO</value>
        </param>
        <param>
            <name>ALMOST_FULL_NUM</name>
            <value>11</value>
        </param>
        <param>
            <name>SYNC_EN</name>
            <value>true</value>
        </param>
        <param>
            <name>ASYNC_EN</name>
            <value>false</value>
        </param>
        <param>
            <name>ALMOST_EMPTY_NUM</name>
            <value>4</value>
        </param>
        <param>
            <name>RD_WATER_LEVEL_ENABLE</name>
            <value>false</value>
        </param>
        <param>
            <name>OUT_REG</name>
            <value>false</value>
        </param>
        <param>
            <name>DATA_WIDTH</name>
            <value>133</value>
        </param>
        <param>
            <name>WR_WATER_LEVEL_ENABLE</name>
            <value>false</value>
        </param>
    </param_list>
    <pin_list>
        <pin>
            <name>wr_data</name>
            <text>wr_data</text>
            <dir>input</dir>
            <pos>left</pos>
            <msb>132</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>wr_en</name>
            <text>wr_en</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>full</name>
            <text>full</text>
            <dir>output</dir>
            <pos>right</pos>
        </pin>
        <pin>
            <name>almost_full</name>
            <text>almost_full</text>
            <dir>output</dir>
            <pos>right</pos>
        </pin>
        <pin>
            <name>rd_data</name>
            <text>rd_data</text>
            <dir>output</dir>
            <pos>right</pos>
            <msb>132</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>rd_en</name>
            <text>rd_en</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>empty</name>
            <text>empty</text>
            <dir>output</dir>
            <pos>right</pos>
        </pin>
        <pin>
            <name>almost_empty</name>
            <text>almost_empty</text>
            <dir>output</dir>
            <pos>right</pos>
        </pin>
        <pin>
            <name>clk</name>
            <text>clk</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>rst</name>
            <text>rst</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
    </pin_list>
    <synthesis>
        <script><![CDATA[set_option -vlog_std v2001]]></script>
        <script><![CDATA[set_option -disable_io_insertion 1]]></script>
    </synthesis>
    <file_list>
        <output>
            <file pathname="generate.log" format="log" description="Generate Log"/>
            <file pathname="ddr_fifo16_r_tb.v" format="verilog" description="Compiled File"/>
            <file pathname="ddr_fifo16_r_tmpl.v" format="verilog" description="Instantiation Template"/>
            <file pathname="ddr_fifo16_r_tmpl.vhdl" format="vhdl" description="Instantiation Template"/>
        </output>
        <source>
            <file pathname="rtl/ipm_distributed_fifo_ctr_v1_1_ddr_fifo16_r.v"/>
            <file pathname="rtl/ipm_distributed_fifo_v1_4_ddr_fifo16_r.v"/>
            <file pathname="rtl/ipm_distributed_sdpram_v1_3_ddr_fifo16_r.v"/>
            <file pathname="ddr_fifo16_r.v"/>
        </source>
    </file_list>
</ip_inst>
