# ??????????
Target = app

# ?????g++
CXX = g++

# ??????????
build_dir = build

# ??????????
src_dir = sources

# ??????????
inc_dir = includes

# ????*.cpp??
sources = $(filter-out $(src_dir)/main_npu.cpp,$(wildcard $(src_dir)/*.cpp))

# ??????*.o??
objects = $(patsubst %.cpp,$(build_dir)/%.o,$(notdir $(sources)))

# ????
includes = $(foreach dir,$(inc_dir),$(wildcard $(dir)/*.h))

# ??????????????
CXXFLAGS = -O3 $(patsubst %, -I%, $(inc_dir))

# ????????
GTK = `pkg-config --cflags --libs gtk+-2.0 gmodule-export-2.0`
# --- ?? OpenCV???? DRM ???????? ---
DRM = `pkg-config --cflags --libs libdrm`
# --- RGA ??????? ---
RGA = -lrga

# ????
$(build_dir)/$(Target) : $(objects) | create_build
	$(CXX) $^ -o $@ $(GTK) $(DRM) $(RGA)

# ????
$(build_dir)/%.o : $(src_dir)/%.cpp $(includes) | create_build
	$(CXX) -c $(CXXFLAGS) $< -o $@ $(GTK) $(DRM) $(RGA)

# ????????????make ????
.PHONY: clean check create_build cp

# ??????
clean:
	rm -rf $(build_dir)

# ???????????????
check:
	@echo $(CXXFLAGS)
	@echo $(CURDIR)
	@echo $(src_dir)
	@echo $(sources)
	@echo $(objects)
	 
# ????????????
create_build:
	@mkdir -p $(build_dir)

# ????????????????
cp: 
	cp ./build/$(Target) ./

# ---- NPU inference standalone target (no RGA/DRM/GTK dependency) ----
npu: sources/main_npu.cpp sources/pci_dma_bridge.cpp $(inc_dir)/pcie_dma_read_test.h $(inc_dir)/npu_config.h | create_build
	$(CXX) -O3 -I$(inc_dir) sources/main_npu.cpp sources/pci_dma_bridge.cpp -o build/npu_inference -lpthread
	@echo "NPU inference app built: build/npu_inference"