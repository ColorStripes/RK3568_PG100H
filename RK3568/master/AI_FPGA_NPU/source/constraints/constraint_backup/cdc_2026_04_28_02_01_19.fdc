# 假设源时钟是 clk_a，目标时钟是 clk_b
set_false_path  -from [get_pins {ov5640_top/ov5640/ov5640_cdc/cam_clk}] -to [get_pins {ov5640_top/ov5640/ov5640_cdc/video_clk}]
set_false_path  -from [get_pins {ov5640_top/pipe_cdc/src_clk}] -to [get_pins {ov5640_top/pipe_cdc/dest_clk}]


set_false_path  -from [get_pins {npu_cdc_top/npu_to_core_cdc_bridge/npu_clk}] -to [get_pins {npu_cdc_top/npu_to_core_cdc_bridge/axi_clk}]
set_false_path  -from [get_pins {npu_cdc_top/npu_to_core_cdc_bridge/axi_clk}] -to [get_pins npu_cdc_top/npu_to_core_cdc_bridge/npu_clk]
